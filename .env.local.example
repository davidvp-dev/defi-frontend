# Gratis en https://cloud.walletconnect.com (necesario para el conector WalletConnect)
VITE_WALLETCONNECT_PROJECT_ID=

# Incluir la red del fork local (pon false en el despliegue público)
VITE_ENABLE_LOCAL_FORK=true

# Nodo local: anvil forkeado de Arbitrum (scripts/bootstrap-local.sh usa --chain-id 1337)
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_LOCAL_CHAIN_ID=1337
# Dirección de CustomDEX en el fork local (ver broadcast/DeployCustomDEX.s.sol/1337/run-latest.json)
VITE_CONTRACT_ADDRESS_LOCAL=

# Arbitrum One (cuando lo despliegues de verdad)
VITE_CONTRACT_ADDRESS_ARBITRUM=
